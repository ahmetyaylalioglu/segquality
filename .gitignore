# Raw label/image volumes are large and live outside the repo (Google Drive /
# local disk). Never commit them.
*.nii.gz
*.nii

# By default every *.npz is ignored (sweep caches, scratch archives). The three
# canonical precomputed splits are re-included below so the advisor can clone and
# run without downloading raw RAOS.
*.npz

# outputs/ is generated. Ignore it wholesale, then re-include ONLY the canonical
# artifacts the advisor needs to clone-and-run. These travel via Git LFS (see
# .gitattributes) so the repo itself stays small.
outputs/*
!outputs/checkpoints/
outputs/checkpoints/*
!outputs/checkpoints/vae3d_vqvae_best.pt
!outputs/checkpoints/vae3d_wp2_base_best.pt
!outputs/checkpoints/vae3d_wp3_sdf_best.pt
# Mask-only shape-ceiling models (used to recompute the ceiling JSONs below).
!outputs/checkpoints/vae3d_simvq_best.pt
!outputs/checkpoints/vae3d_sdfio_best.pt
!outputs/checkpoints/vae3d_simvq_sdfio_best.pt
# Image-conditioned workstream (E2-E7 + partial variants) used by the report notebook.
!outputs/checkpoints/vae3d_e2_best.pt
!outputs/checkpoints/vae3d_e3_best.pt
!outputs/checkpoints/vae3d_e4_best.pt
!outputs/checkpoints/vae3d_e5_best.pt
!outputs/checkpoints/vae3d_e6_best.pt
!outputs/checkpoints/vae3d_e7_best.pt
!outputs/checkpoints/vae3d_e3p_best.pt
!outputs/checkpoints/vae3d_e6p_best.pt
!outputs/checkpoints/vae3d_e7p_best.pt
# Ceiling correlation results read by the report notebook.
!outputs/correlation_results_vq.json
!outputs/correlation_results_simvq_simvq.json
!outputs/correlation_results_sdfio_sdfio.json
!outputs/correlation_results_simvq_sdfio_simvq_sdfio.json
# Report figures.
!outputs/rapor_*.png
!outputs/volumes/
outputs/volumes/*
!outputs/volumes/train.npz
!outputs/volumes/val.npz
!outputs/volumes/test.npz

.venv/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/

# Auto-generated by the training notebooks (64^3 override of configs/vae3d.yaml)
configs/vae3d_full.yaml

# Large scratch archives (e.g. aciklama/*.zip) — never commit.
*.zip

# Third-party reference implementations cloned for study (VAR, SAR3D). Not ours.
_reference_repos/

# Generated outputs inside the explanatory folder (keep notebooks/scripts, drop artifacts).
aciklama/outputs/

# OS / editor
.DS_Store
.idea/
.vscode/
